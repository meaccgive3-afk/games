# ---------------------------------------------------------------
# انسخ هذا الملف إلى .env.local وحط القيم الحقيقية هناك.
# .env.local لا يُرفع إلى GitHub (محمي في .gitignore).
# هذا الملف يحتوي أسماء المتغيرات فقط — بدون قيم.
# ---------------------------------------------------------------

# قاعدة البيانات (Postgres) — بدونها لا تُنشأ الغرف
DATABASE_URL=

# حكم الذكاء الاصطناعي (BluesMinds)
BLUESMINDS_API_KEY=
BLUESMINDS_BASE_URL=

# Cloudflare R2 — لرفع صور اللاعبين
R2_ACCOUNT_ID=
R2_S3_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# الرابط العام للـ bucket (r2.dev أو دومين مخصص).
# مهم: هذا مختلف عن R2_S3_ENDPOINT. بدونه تبقى الصور مطفية في التطبيق.
NEXT_PUBLIC_R2_PUBLIC_URL=

# خدمة الكابتشا (اختياري)
CAP_SERVER_URL=
